{
  "name": "gtcp-backend",
  "version": "0.12.0",
  "description": "GTCP — Gas Trading & Commercial Platform API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "jest tests/ --verbose --forceExit --detectOpenHandles",
    "test:coverage": "jest tests/ --verbose --coverage --forceExit --detectOpenHandles",
    "test:db": "dotenv -e .env.test -- jest tests/ --verbose --forceExit --detectOpenHandles",
    "test:db:coverage": "dotenv -e .env.test -- jest tests/ --verbose --coverage --forceExit --detectOpenHandles",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed-runner.js",
    "db:reset": "node src/db/migrate.js && node src/db/seed-runner.js",
    "count-endpoints": "node scripts/count-endpoints.js",
    "fix-fuel-gas": "node -r dotenv/config scripts/fix-fuel-gas-invoices.js",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d db",
    "docker:test:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "argon2": "^0.40.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.20.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ]
  }
}
